<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>{{ID}}</Id>
  <Version>{{VERSION}}</Version>
  <ProviderName>Live HTML</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="Live HTML"/>
  <Description DefaultValue="슬라이드 안에서 HTML 파일을 실행합니다."/>
  <IconUrl DefaultValue="{{HOST}}/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="{{HOST}}/icon-64.png"/>
  <SupportUrl DefaultValue="{{HOST}}/index.html"/>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="{{HOST}}/index.html"/>
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>540</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
